CHAT_DEPLOYMENT=gpt-4.1-mini
EMBED_DEPLOYMENT=text-embedding-3-small
VECTOR_STORE=chroma           # chroma | azure_search
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
